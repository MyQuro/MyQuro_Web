{
  "services": [
    {
      "type": "web",
      "name": "myquro-backend",
      "env": "node",
      "rootDir": "backend",
      "buildCommand": "npm install && npm run build",
      "startCommand": "npm start",
      "envVars": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "PORT",
          "value": "10000"
        },
        {
          "key": "DATABASE_URL",
          "generateValue": false,
          "fromSecret": false
        },
        {
          "key": "BETTER_AUTH_SECRET",
          "generateValue": false,
          "fromSecret": false
        },
        {
          "key": "BETTER_AUTH_URL",
          "generateValue": false,
          "fromSecret": false
        },
        {
          "key": "CLIENT_URL",
          "generateValue": false,
          "fromSecret": false
        },
        {
          "key": "GOOGLE_CLIENT_ID",
          "generateValue": false,
          "fromSecret": false
        },
        {
          "key": "GOOGLE_CLIENT_SECRET",
          "generateValue": false,
          "fromSecret": false
        }
      ],
      "healthCheckPath": "/health",
      "autoDeploy": true
    },
    {
      "type": "web",
      "name": "myquro-frontend",
      "env": "node",
      "rootDir": "frontend",
      "buildCommand": "npm install && npm run build",
      "startCommand": "npm start",
      "envVars": [
        {
          "key": "NEXT_PUBLIC_BACKEND_URL",
          "generateValue": false,
          "fromSecret": false
        }
      ],
      "autoDeploy": true
    }
  ]
}